# Copy to .env in this folder, or export the variables in your shell.
# .env is ignored by Git. Never commit a key, and never paste one into a notebook.
#
# The runner (metaharness/run_harness.py) loads .env from this folder.
# The notebooks read the environment of the Jupyter process, so export the variables
# before you start Jupyter. A notebook asks with getpass when a required key is missing.

# Required: the MemAgent, pi and Hermes use it in the default configuration.
ANTHROPIC_API_KEY=

# Optional: enables the DeepSeek harness (Claude Code's loop on DeepSeek's API).
# Without it the readiness probe reports authentication_required and the run is skipped.
DEEPSEEK_API_KEY=

# Model and depth. Current Claude models take no temperature, top_p, top_k or thinking budget.
PPA_MODEL=claude-opus-5-5
PPA_EFFORT=medium

# The external harnesses. Give a full path when the program is not on PATH.
# MEMORIZZ_PI_COMMAND=.tools/node_modules/.bin/pi
# MEMORIZZ_HERMES_COMMAND=.tools/hermes-venv/bin/hermes
# MEMORIZZ_DEEPSEEK_COMMAND=claude

# pi and Hermes accept any provider they support. These are the defaults.
# MEMORIZZ_PI_PROVIDER=anthropic
# MEMORIZZ_PI_MODEL=claude-opus-5-5
# MEMORIZZ_HERMES_PROVIDER=anthropic
# MEMORIZZ_HERMES_MODEL=claude-opus-5-5
# MEMORIZZ_DEEPSEEK_MODEL=deepseek-flash

# Embeddings, served locally by Ollama. Without an embedding model the notebooks fall
# back to keyword recall. The runner also accepts PPA_EMBEDDING_PROVIDER=none.
# PPA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_HOST=http://127.0.0.1:11434

# Memory backend: filesystem (default, tested) or oracle (not tested in this track).
# PPA_MEMORY_BACKEND=filesystem
# ORACLE_USER=
# ORACLE_PASSWORD=
# ORACLE_DSN=

# Where a notebook keeps its state and its workspace. The defaults are folders next to
# the notebook: ppa_data and ppa_workspace.
# PPA_HOME=
# PPA_WORKSPACE=

# A MemoRizz build for the meta-harness notebook, when the PyPI release has no adapters.
# PPA_MEMORIZZ_SPEC=memorizz[anthropic,filesystem] @ file:///path/to/memorizz
