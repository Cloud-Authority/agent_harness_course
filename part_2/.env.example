# Part 2 · PPA. Copy to the repository's .env or export in your shell.
# Git ignores .env. Never put a key in a notebook.

# Required for live answers in every track
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Custom-harness notebook: Oracle AI Database 26ai in Docker
ORACLE_ADMIN_PASSWORD=
PPA_ORA_DSN=127.0.0.1:1524/FREEPDB1
PPA_ORA_USER=PPA_AGENT
PPA_ORA_PWD=PpaAgent_2026!

# System One (Jev, from Typesafe). Optional: without it the harness uses rules and vector search
TYPESAFE_API_KEY=

# Optional services
TAVILY_API_KEY=
E2B_API_KEY=
LANGSMITH_API_KEY=

# Done-for-you track, DeepSeek harness only
DEEPSEEK_API_KEY=

# Appbook
PPA_RESPONDER=auto
PPA_GENERATED_CALENDAR=1
